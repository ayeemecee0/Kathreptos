map $http_origin $katoptron_origin {
  default "";
  "https://ayeemecee0.github.io" "https://ayeemecee0.github.io";
}
limit_req_zone $binary_remote_addr zone=routing:10m rate=2r/s;
limit_req_zone $binary_remote_addr zone=geocoding:10m rate=1r/s;
server {
  listen ${PORT};
  server_tokens off;
  access_log off;
  error_log /dev/stderr crit;
  client_max_body_size 1k;
  add_header Cache-Control "no-store" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header X-Content-Type-Options "nosniff" always;
  location = /healthz {
    default_type text/plain;
    return 200 "gateway-alive; not an upstream-readiness proof";
  }
  location ^~ /route/v1/driving/ {
    limit_req zone=routing burst=5 nodelay;
    limit_req_status 429;
    if ($request_method != GET) { return 405; }
    if ($http_origin != "https://ayeemecee0.github.io") { return 403; }
    add_header Access-Control-Allow-Origin "https://ayeemecee0.github.io" always;
    add_header Vary Origin always;
    add_header Cache-Control "no-store" always;
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_set_header Referer "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Real-IP "";
    proxy_read_timeout 22s;
    proxy_connect_timeout 5s;
    proxy_hide_header Set-Cookie;
    proxy_pass ${ROUTING_UPSTREAM};
  }
  location ^~ /api/ {
    limit_req zone=geocoding burst=3 nodelay;
    limit_req_status 429;
    if ($request_method != GET) { return 405; }
    if ($http_origin != "https://ayeemecee0.github.io") { return 403; }
    add_header Access-Control-Allow-Origin "https://ayeemecee0.github.io" always;
    add_header Vary Origin always;
    add_header Cache-Control "no-store" always;
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_set_header Referer "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Real-IP "";
    proxy_read_timeout 15s;
    proxy_connect_timeout 5s;
    proxy_hide_header Set-Cookie;
    proxy_pass ${GEOCODING_UPSTREAM};
  }
  location / { return 404; }
}
